# Copy this file to .env and fill in your keys. Never commit .env.

# --- LLMs ---
# Groq (primary): https://console.groq.com/keys
GROQ_API_KEY=
# NVIDIA NIM (fallback after Groq, free for development): https://build.nvidia.com
NVIDIA_API_KEY=
# Gemini (last-resort fallback): https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Model selection
# (Groq Llama models are enterprise-only; gpt-oss is available on the free tier)
GROQ_MODEL=openai/gpt-oss-20b
GROQ_MODEL_STRONG=openai/gpt-oss-120b
# Set to true for final runs/demo: planner, writer and critic use GROQ_MODEL_STRONG
USE_STRONG_MODEL=false
GEMINI_MODEL=gemini-2.5-flash
# NIM model (OpenAI-compatible endpoint; structured output uses JSON mode + validation)
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
# Groq daily token quotas are per model, so Groq models back each other up before Gemini is used.
# (Free tier: ~200k tokens/day per gpt-oss model; gemini-2.5-flash only ~20 requests/day.)
GROQ_FALLBACK_MODELS=openai/gpt-oss-20b,openai/gpt-oss-120b
# Third Groq quota pool, appended to the chain above (empty = off). Free tier: 1000 output tokens/min, so its
# max_tokens is capped at 1000; it runs without reasoning and uses function calling for structured output.
GROQ_MODEL_EXTRA=qwen/qwen3.8-27b
# false = no model switching: a quota error stops the run (use for fair before/after comparisons)
LLM_FALLBACKS=true
# Reasoning effort for Groq gpt-oss models (low | medium | high)
GROQ_REASONING_EFFORT=low
# Output token budget per LLM call (includes reasoning tokens for gpt-oss)
LLM_MAX_TOKENS=4096

# --- Tools ---
# Tavily search (primary): https://app.tavily.com  (DuckDuckGo is used if empty or failing)
TAVILY_API_KEY=

# --- Agent limits ---
MAX_PLAN_STEPS=6
MAX_REACT_ITERATIONS=4
MAX_REVISIONS=2
CRITIC_PASS_SCORE=7
PAGE_CHAR_LIMIT=3000
# SQLite memory (lessons, trusted sources, runs); point at another file to keep experiments apart
# MEMORY_DB_PATH=data/agent_memory.db
# Search results per query, chars per snippet, and chars of each earlier step's findings the executor sees (0 = all)
SEARCH_MAX_RESULTS=5
SNIPPET_CHARS=800
STEP_CONTEXT_CHARS=0

# Development: spend fewer tokens. Lowers the defaults of the limits above to 3 steps, 3 LLM calls/step,
# 1 revision, 1200-char pages, 3 results x 300-char snippets, 600-char step context.
# These are caps: a smaller value set above still wins.
TOKEN_SAVER=false
