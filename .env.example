# Copy this file to .env and fill in your keys. Never commit .env.

# --- LLMs ---
# Groq (primary): https://console.groq.com/keys
GROQ_API_KEY=
# Gemini (fallback): https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Model selection
# (Groq Llama models are enterprise-only; gpt-oss is available on the free tier)
GROQ_MODEL=openai/gpt-oss-20b
GROQ_MODEL_STRONG=openai/gpt-oss-120b
# Set to true for final runs/demo: planner, writer and critic use GROQ_MODEL_STRONG
USE_STRONG_MODEL=false
GEMINI_MODEL=gemini-2.5-flash
# Groq daily token quotas are per model, so Groq models back each other up before Gemini is used.
# (Free tier: ~200k tokens/day per gpt-oss model; gemini-2.5-flash only ~20 requests/day.)
GROQ_FALLBACK_MODELS=openai/gpt-oss-20b,openai/gpt-oss-120b
# Reasoning effort for Groq gpt-oss models (low | medium | high)
GROQ_REASONING_EFFORT=low
# Output token budget per LLM call (includes reasoning tokens for gpt-oss)
LLM_MAX_TOKENS=4096

# --- Tools ---
# Tavily search (primary): https://app.tavily.com  (DuckDuckGo is used if empty or failing)
TAVILY_API_KEY=

# --- Agent limits ---
MAX_PLAN_STEPS=6
MAX_REACT_ITERATIONS=4
MAX_REVISIONS=2
CRITIC_PASS_SCORE=7
PAGE_CHAR_LIMIT=3000
